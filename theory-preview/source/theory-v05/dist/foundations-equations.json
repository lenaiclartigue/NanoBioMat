{"swangle":"<div class=\"equation-line\"><span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mfrac><mi>E</mi><mrow><mi>K</mi><mi>V</mi></mrow></mfrac><mo>=</mo><msup><mrow><mi>sin</mi><mo>⁡</mo></mrow><mn>2</mn></msup><mo stretchy=\"false\">(</mo><mi>φ</mi><mo>−</mo><mi>α</mi><mo stretchy=\"false\">)</mo><mo>−</mo><mn>2</mn><mi>h</mi><mi>cos</mi><mo>⁡</mo><mi>φ</mi></mrow><annotation encoding=\"application/x-tex\">\\frac{E}{KV}=\\sin^2(\\varphi-\\alpha)-2h\\cos\\varphi</annotation></semantics></math></span></div><div class=\"equation-line\"><span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mi>h</mi><mo>=</mo><mfrac><mi>H</mi><msub><mi>H</mi><mi>K</mi></msub></mfrac><mo separator=\"true\">,</mo><mspace width=\"2em\"/><msub><mi>μ</mi><mn>0</mn></msub><msub><mi>H</mi><mi>K</mi></msub><mo>=</mo><mfrac><mrow><mn>2</mn><mi>K</mi></mrow><msub><mi>M</mi><mrow><mi mathvariant=\"normal\">s</mi><mo separator=\"true\">,</mo><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">e</mi></mrow></msub></mfrac></mrow><annotation encoding=\"application/x-tex\">h=\\frac{H}{H_K},\\qquad \\mu_0 H_K=\\frac{2K}{M_{\\mathrm{s,core}}}</annotation></semantics></math></span></div>","mh":"<div class=\"equation-line\"><span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><msub><mi>m</mi><mi>r</mi></msub><mo>=</mo><mfrac><msub><mi>M</mi><mi>R</mi></msub><msub><mi>M</mi><mi>S</mi></msub></mfrac><mo separator=\"true\">,</mo><mspace width=\"2em\"/><mi>M</mi><mo stretchy=\"false\">(</mo><msub><mi>H</mi><mi>C</mi></msub><mo stretchy=\"false\">)</mo><mo>=</mo><mn>0</mn></mrow><annotation encoding=\"application/x-tex\">m_r=\\frac{M_R}{M_S},\\qquad M(H_C)=0</annotation></semantics></math></span></div><div class=\"equation-line\"><span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><msub><mrow><mo fence=\"true\">⟨</mo><mi mathvariant=\"normal\">∣</mi><mi>cos</mi><mo>⁡</mo><mi>α</mi><mi mathvariant=\"normal\">∣</mi><mo fence=\"true\">⟩</mo></mrow><mrow><mn>3</mn><mi mathvariant=\"normal\">D</mi></mrow></msub><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><annotation encoding=\"application/x-tex\">\\left\\langle|\\cos\\alpha|\\right\\rangle_{\\mathrm{3D}}=\\frac12</annotation></semantics></math></span></div>","initial":"<div class=\"equation-line\"><span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mfrac><mi>M</mi><msub><mi>M</mi><mi>S</mi></msub></mfrac><mo>=</mo><mi mathvariant=\"script\">L</mi><mo stretchy=\"false\">(</mo><mi>ξ</mi><mo stretchy=\"false\">)</mo><mo separator=\"true\">,</mo><mspace width=\"2em\"/><mi mathvariant=\"script\">L</mi><mo stretchy=\"false\">(</mo><mi>ξ</mi><mo stretchy=\"false\">)</mo><mo>=</mo><mi>coth</mi><mo>⁡</mo><mi>ξ</mi><mo>−</mo><mfrac><mn>1</mn><mi>ξ</mi></mfrac></mrow><annotation encoding=\"application/x-tex\">\\frac{M}{M_S}=\\mathcal L(\\xi),\\qquad\\mathcal L(\\xi)=\\coth\\xi-\\frac1\\xi</annotation></semantics></math></span></div><div class=\"equation-line\"><span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mi>ξ</mi><mo>=</mo><mfrac><mrow><mi>μ</mi><msub><mi>μ</mi><mn>0</mn></msub><mi>H</mi></mrow><mrow><msub><mi>k</mi><mi mathvariant=\"normal\">B</mi></msub><mi>T</mi></mrow></mfrac><mo separator=\"true\">,</mo><mspace width=\"2em\"/><mi>μ</mi><mo>=</mo><msub><mi>M</mi><mrow><mi mathvariant=\"normal\">s</mi><mo separator=\"true\">,</mo><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">e</mi></mrow></msub><mi>V</mi></mrow><annotation encoding=\"application/x-tex\">\\xi=\\frac{\\mu\\mu_0H}{k_{\\mathrm B}T},\\qquad\\mu=M_{\\mathrm{s,core}}V</annotation></semantics></math></span></div><div class=\"equation-line\"><span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mfrac><mi>M</mi><msub><mi>M</mi><mi>S</mi></msub></mfrac><mo>=</mo><mfrac><mrow><mo>∫</mo><mi>V</mi><mtext> </mtext><mi>f</mi><mo stretchy=\"false\">(</mo><mi>V</mi><mo stretchy=\"false\">)</mo><mtext> </mtext><mi mathvariant=\"script\">L</mi><mtext> ⁣</mtext><mrow><mo fence=\"true\">(</mo><mfrac><mrow><msub><mi>M</mi><mrow><mi mathvariant=\"normal\">s</mi><mo separator=\"true\">,</mo><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">e</mi></mrow></msub><mi>V</mi><msub><mi>μ</mi><mn>0</mn></msub><mi>H</mi></mrow><mrow><msub><mi>k</mi><mi mathvariant=\"normal\">B</mi></msub><mi>T</mi></mrow></mfrac><mo fence=\"true\">)</mo></mrow><mtext> </mtext><mi mathvariant=\"normal\">d</mi><mi>V</mi></mrow><mrow><mo>∫</mo><mi>V</mi><mtext> </mtext><mi>f</mi><mo stretchy=\"false\">(</mo><mi>V</mi><mo stretchy=\"false\">)</mo><mtext> </mtext><mi mathvariant=\"normal\">d</mi><mi>V</mi></mrow></mfrac></mrow><annotation encoding=\"application/x-tex\">\\frac{M}{M_S}=\\frac{\\int V\\,f(V)\\,\\mathcal L\\!\\left(\\frac{M_{\\mathrm{s,core}}V\\mu_0H}{k_{\\mathrm B}T}\\right)\\,\\mathrm dV}{\\int V\\,f(V)\\,\\mathrm dV}</annotation></semantics></math></span></div>","zfc":"<div class=\"equation-line\"><span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><msub><mi>τ</mi><mi>N</mi></msub><mo>≈</mo><msub><mi>τ</mi><mn>0</mn></msub><mi>exp</mi><mo>⁡</mo><mtext> ⁣</mtext><mrow><mo fence=\"true\">(</mo><mfrac><mrow><mi>K</mi><mi>V</mi></mrow><mrow><msub><mi>k</mi><mi mathvariant=\"normal\">B</mi></msub><mi>T</mi></mrow></mfrac><mo fence=\"true\">)</mo></mrow><mo separator=\"true\">,</mo><mspace width=\"2em\"/><msub><mi>τ</mi><mn>0</mn></msub><mo>=</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>9</mn></mrow></msup><mtext> </mtext><mi mathvariant=\"normal\">s</mi></mrow><annotation encoding=\"application/x-tex\">\\tau_N\\approx\\tau_0\\exp\\!\\left(\\frac{KV}{k_{\\mathrm B}T}\\right),\\qquad \\tau_0=10^{-9}\\,\\mathrm s</annotation></semantics></math></span></div><div class=\"equation-line\"><span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><msub><mi>T</mi><mi>B</mi></msub><mo>≈</mo><mfrac><mrow><mi>K</mi><mi>V</mi></mrow><mrow><msub><mi>k</mi><mi mathvariant=\"normal\">B</mi></msub><mi>ln</mi><mo>⁡</mo><mo stretchy=\"false\">(</mo><msub><mi>t</mi><mi>m</mi></msub><mi mathvariant=\"normal\">/</mi><msub><mi>τ</mi><mn>0</mn></msub><mo stretchy=\"false\">)</mo></mrow></mfrac></mrow><annotation encoding=\"application/x-tex\">T_B\\approx\\frac{KV}{k_{\\mathrm B}\\ln(t_m/\\tau_0)}</annotation></semantics></math></span></div>"}