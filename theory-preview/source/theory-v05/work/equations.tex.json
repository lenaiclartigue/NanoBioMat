{
  "macrospin": [
    "\\boldsymbol{\\mu}=\\sum_i\\boldsymbol{\\mu}_i",
    "\\lvert\\boldsymbol{\\mu}\\rvert=M_{\\mathrm{s,core}}V"
  ],
  "anisotropy": [
    "E(\\theta)=KV\\sin^2\\theta",
    "\\Delta E=KV,\\qquad \\sigma=\\frac{KV}{k_{\\mathrm B}T}"
  ],
  "relax": [
    "\\tau_{\\mathrm N}\\approx\\tau_0\\exp\\!\\left(\\frac{KV}{k_{\\mathrm B}T}\\right)",
    "\\tau_{\\mathrm B}=\\frac{3\\eta V_{\\mathrm h}}{k_{\\mathrm B}T},\\qquad \\tau_0=10^{-9}\\,\\mathrm{s}"
  ],
  "interactions": [
    "U_{\\mathrm{dd}}=\\frac{\\mu_0}{4\\pi r^3}\\left[\\boldsymbol{\\mu}_1\\cdot\\boldsymbol{\\mu}_2-3(\\boldsymbol{\\mu}_1\\cdot\\hat{\\boldsymbol r})(\\boldsymbol{\\mu}_2\\cdot\\hat{\\boldsymbol r})\\right]"
  ],
  "mri": [
    "\\frac{M_z(t)}{M_0}=1-\\exp\\!\\left(-\\frac{t}{T_1}\\right)",
    "\\frac{M_{xy}(t)}{M_0}=\\exp\\!\\left(-\\frac{t}{T_2}\\right)"
  ],
  "heat": [
    "H(t)=H_0\\sin(\\omega t)",
    "M(t)=M_0\\sin(\\omega t-\\varphi)"
  ],
  "zfc": [
    "\\tau_{\\mathrm N}=\\tau_0\\exp\\!\\left(\\frac{K_{\\mathrm{eff}}V}{k_{\\mathrm B}T}\\right)",
    "T_{\\mathrm B}^{*}=\\frac{K_{\\mathrm{eff}}V}{k_{\\mathrm B}\\ln(t_{\\mathrm m}/\\tau_0)}"
  ],
  "mh": [
    "\\frac{E(\\varphi)}{KV}=\\sin^2(\\varphi-\\theta)-2h\\cos\\varphi",
    "h=\\frac{H}{H_{\\mathrm K}},\\qquad \\mu_0H_{\\mathrm K}=\\frac{2K_{\\mathrm{eff}}}{M_{\\mathrm{s,core}}}"
  ],
  "initial": [
    "\\mathcal L(\\xi)=\\coth\\xi-\\frac1\\xi,\\qquad \\xi=\\frac{\\mu\\mu_0H}{k_{\\mathrm B}T}",
    "\\frac{M}{M_{\\mathrm{s,ensemble}}}=\\mathcal L(\\xi),\\qquad \\mu=M_{\\mathrm{s,core}}V",
    "\\lim_{\\xi\\to0}\\mathcal L(\\xi)=0,\\qquad \\lim_{\\xi\\to+\\infty}\\mathcal L(\\xi)=1",
    "\\Gamma_{\\pm}=\\frac{1}{2\\tau_0}\\exp\\!\\left(-\\frac{\\Delta E_{\\pm}}{k_{\\mathrm B}T}\\right)"
  ],
  "rem": [
    "\\Delta M(H)=m_{\\mathrm{DCD}}(H)-[1-2m_{\\mathrm{IRM}}(H)]",
    "\\Delta M(H)=0\\quad\\text{(Wohlfarth)}"
  ],
  "time": [
    "M(t)=\\sum_i\\mu_i\\langle\\cos\\theta_i\\rangle_0\\exp\\!\\left(-\\frac{t}{\\tau_i}\\right)",
    "\\tau_i=\\tau_0\\exp\\!\\left(\\frac{K_{\\mathrm{eff}}V_i}{k_{\\mathrm B}T}\\right)"
  ],
  "forc": [
    "\\rho(H,H_{\\mathrm r})=-\\frac12\\frac{\\partial^2 M(H,H_{\\mathrm r})}{\\partial H\\,\\partial H_{\\mathrm r}}",
    "H_{\\mathrm c}=\\frac{H-H_{\\mathrm r}}2,\\qquad H_{\\mathrm u}=\\frac{H+H_{\\mathrm r}}2"
  ]
}